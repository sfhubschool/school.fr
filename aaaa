	bgFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
	bgFrame.BackgroundTransparency = 0.25
	bgFrame.Parent = billboard
	
	local frameCorner = Instance.new("UICorner")
	frameCorner.CornerRadius = UDim.new(0, 8)
	frameCorner.Parent = bgFrame
	
	local frameStroke = Instance.new("UIStroke")
	frameStroke.Color = auraColor
	frameStroke.Thickness = 1.8
	frameStroke.Transparency = 0.1
	frameStroke.Parent = bgFrame
	
	local txt = Instance.new("TextLabel")
	txt.Name = "Info"
	txt.Size = UDim2.new(1, 0, 1, 0)
	txt.BackgroundTransparency = 1
	txt.TextColor3 = auraColor
	txt.TextStrokeTransparency = 0.5
	txt.TextSize = 12
	txt.Font = Enum.Font.GothamBold
	txt.Text = "🎃 [...]"
	txt.Parent = bgFrame
	
	billboard.Parent = coin
	
	-- Effet Néon 3D au-travers des murs (Highlight)
	local highlight = Instance.new("Highlight")
	highlight.Name = "CoinHighlight"
	highlight.Adornee = coin
	highlight.FillColor = auraColor
	highlight.FillTransparency = 0.5
	highlight.OutlineColor = auraColor
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = coin

	return {
		Billboard = billboard,
		Highlight = highlight,
		Stroke = frameStroke,
		Label = txt,
		Color = auraColor
	}
end

-- Gestion ESP Pièces en arrière-plan
task.spawn(function()
	while true do
		task.wait(0.3)
		if espEnabled then
			pcall(function()
				local char = localPlayer.Character
				local rootPart = char and char:FindFirstChild("HumanoidRootPart")
				
				-- Nettoyer les ESP périmés
				for coin, data in pairs(activeEsp) do
					if not isCoinValid(coin) then
						if data.Billboard then data.Billboard:Destroy() end
						if data.Highlight then data.Highlight:Destroy() end
						activeEsp[coin] = nil
					end
				end
				
				-- Ajouter/Mettre à jour les ESP des pièces avec leur aura
				for _, obj in ipairs(Workspace:GetDescendants()) do
					if obj and obj:IsA("BasePart") then
						local nameLower = obj.Name:lower()
						if nameLower == "coin" or nameLower == "coins" or nameLower:find("coin") or nameLower:find("piece") or nameLower:find("pièce") then
							if isCoinValid(obj) then
								if not activeEsp[obj] then
									local auraColor = detectCoinAuraColor(obj)
									activeEsp[obj] = createAuraEsp(obj, auraColor)
								else
									-- Mettre à jour la distance & vérifier la couleur si l'aura change
									local data = activeEsp[obj]
									if data and data.Label and rootPart then
										local dist = math.floor((obj.Position - rootPart.Position).Magnitude)
										data.Label.Text = "🎃 " .. dist .. "m"
									end
								end
							else
								if activeEsp[obj] then
									if activeEsp[obj].Billboard then activeEsp[obj].Billboard:Destroy() end
									if activeEsp[obj].Highlight then activeEsp[obj].Highlight:Destroy() end
									activeEsp[obj] = nil
								end
							end
						end
					end
				end
			end)
		end
	end
end)

-- Boucle principale d'Auto-Farm Ultra-Fluide
task.spawn(function()
	while true do
		task.wait(0.02)
		
		if autoFarmEnabled then
			pcall(function()
				local char = localPlayer.Character
				if not char then return end
				local rootPart = char:FindFirstChild("HumanoidRootPart")
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				
				if not rootPart or not humanoid or humanoid.Health <= 0 then return end
				
				local coin = findNearestValidCoin()
				
				if not coin then
					autofarmBtn.Text = "   Autofarm : Attente pièces..."
					autofarmBtn.TextColor3 = Color3.fromRGB(255, 180, 50)
					task.wait(0.1)
				else
					autofarmBtn.Text = "   Autofarm : ON"
					autofarmBtn.TextColor3 = Color3.fromRGB(90, 255, 90)
					
					humanoid:ChangeState(Enum.HumanoidStateType.Physics)
					rootPart.AssemblyLinearVelocity = Vector3.zero
					rootPart.AssemblyAngularVelocity = Vector3.zero
					
					local startPos = rootPart.Position
					local targetPos = coin.Position
					local distance = (targetPos - startPos).Magnitude
					
					if distance > 0.5 then
						local flyTime = distance / math.max(autoFarmSpeed, 1)
						local elapsed = 0
						
						while elapsed < flyTime and autoFarmEnabled do
							local dt = RunService.RenderStepped:Wait()
							
							if not isCoinValid(coin) then
								break
							end
							
							elapsed = elapsed + dt
							local alpha = math.min(elapsed / flyTime, 1)
							
							targetPos = coin.Position 
							rootPart.CFrame = CFrame.new(startPos:Lerp(targetPos, alpha))
							rootPart.AssemblyLinearVelocity = Vector3.zero
						end
					end
					
					if isCoinValid(coin) then
						rootPart.CFrame = CFrame.new(coin.Position)
						simulateCollection(rootPart, coin)
						
						ignoredCoins[coin] = true
						task.delay(3, function()
							ignoredCoins[coin] = nil
						end)
					end
				end
			end)
		else
			pcall(function()
				local char = localPlayer.Character
				if char and char:FindFirstChildOfClass("Humanoid") then
					char:FindFirstChildOfClass("Humanoid"):ChangeState(Enum.HumanoidStateType.GettingUp)
				end
			end)
			task.wait(0.1)
		end
	end
end)
