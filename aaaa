-- Detection de la couleur de l'aura de la pièce
local function detectCoinAuraColor(coin)
	local defaultColor = Color3.fromRGB(255, 170, 0) -- Couleur Halloween par défaut (Orange)
	
	-- Recherche dans la pièce ou ses enfants (Particules, Lumieres, Effets)
	for _, child in ipairs(coin:GetDescendants()) do
		if child:IsA("ParticleEmitter") then
			local keypoints = child.Color.Keypoints
			if #keypoints > 0 then
				return keypoints[1].Value
			end
		elseif child:IsA("Light") then
			return child.Color
		elseif child:IsA("Highlight") then
			return child.FillColor
		elseif child:IsA("SelectionBox") then
			return child.Color3
		end
	end
	
	-- Si aucun effet d'aura n'est détecté, on prend la couleur de la pièce elle-même
	if coin:IsA("BasePart") and coin.Color then
		return coin.Color
	end
	
	return defaultColor
end

-- Vérification de validité d'une pièce
local function isCoinValid(coin)
	if not coin or not coin.Parent or not coin:IsDescendantOf(Workspace) or coin.Transparency >= 1 or ignoredCoins[coin] then
		return false
	end
	
	local char = localPlayer.Character
	if char and char:FindFirstChild("HumanoidRootPart") then
		local dist = (coin.Position - char.HumanoidRootPart.Position).Magnitude
		if dist > maxCoinDistance then
			return false
		end
	end
	
	return true
end

-- Détection de la pièce la plus proche avec filtre de distance max
local function findNearestValidCoin()
	local nearest = nil
	local shortestDist = math.huge
	local char = localPlayer.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
	local rootPos = char.HumanoidRootPart.Position

	pcall(function()
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj and obj:IsA("BasePart") and isCoinValid(obj) then
				local nameLower = obj.Name:lower()
				if nameLower == "coin" or nameLower == "coins" or nameLower:find("coin") or nameLower:find("piece") or nameLower:find("pièce") then
					if obj.Size.Magnitude > 0 then
						local dist = (obj.Position - rootPos).Magnitude
						if dist <= maxCoinDistance and dist < shortestDist then
							shortestDist = dist
							nearest = obj
						end
					end
				end
			end
		end
	end)
	return nearest
end

-- Collecte instantanée
local function simulateCollection(rootPart, coin)
	pcall(function()
		if firetouchinterest and rootPart and coin then
			firetouchinterest(rootPart, coin, 0)
			firetouchinterest(rootPart, coin, 1)
			firetouchinterest(coin, rootPart, 0)
			firetouchinterest(coin, rootPart, 1)
		end
		
		local prompt = coin:FindFirstChildWhichIsA("ProximityPrompt", true) or (coin.Parent and coin.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
		if prompt and fireproximityprompt then
			fireproximityprompt(prompt)
		end
	end)
end

-- Création d'un ESP Style Halloween / Aura pour une pièce
local function createAuraEsp(coin, auraColor)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "AuraCoinESP"
	billboard.Size = UDim2.new(0, 110, 0, 35)
	billboard.AlwaysOnTop = true
