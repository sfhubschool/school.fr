			-- ÉTAPE 1 : Trajectoire
			if #recordedPath > 0 then
				for i, targetPos in ipairs(recordedPath) do
					if not isPlayingPath or not hrp or not hum or hum.Health <= 0 then break end
					
					-- Réajustement si proche de la position finale
					if i == #recordedPath then
						if (hrp.Position - targetPos).Magnitude < 15 then
							hrp.CFrame = CFrame.new(targetPos)
							break
						end
					end

					hum:MoveTo(targetPos)
					local startT = tick()
					repeat
						task.wait(0.05)
						if (hrp.Position - targetPos).Magnitude < 3 then
							break
						end
					until (tick() - startT) > 2 or not isPlayingPath
				end
			end

			-- ÉTAPE 2 : Séquence TP
			if isPlayingPath and #recordedTp > 0 then
				local tpStartTime = tick()
				for _, tpAction in ipairs(recordedTp) do
