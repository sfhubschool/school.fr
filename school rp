	local espEnabled = false
	local staffEspEnabled = false

	local function checkIsStaff(targetPlayer)
		if targetPlayer.Team then
			local tName = string.lower(targetPlayer.Team.Name)
			if string.find(tName, "staff") or string.find(tName, "admin") or string.find(tName, "mod") or string.find(tName, "gérant") or string.find(tName, "créateur") or string.find(tName, "support") then
				return true, targetPlayer.Team.Name
			end
		end
		return false, nil
	end

	local function detectRole(targetPlayer)
		if targetPlayer.Backpack:FindFirstChild("Knife") or (targetPlayer.Character and targetPlayer.Character:FindFirstChild("Knife")) then
			return "MURDERER", Color3.fromRGB(255, 30, 60)
		elseif targetPlayer.Backpack:FindFirstChild("Gun") or (targetPlayer.Character and targetPlayer.Character:FindFirstChild("Gun")) then
			return "SHERIFF", Color3.fromRGB(0, 140, 255)
		end
		if targetPlayer.Team then return targetPlayer.Team.Name, targetPlayer.TeamColor.Color end
		return "Innocent", Color3.fromRGB(0, 255, 120)
	end

	local function cleanESP(character)
		if not character then return end
		local oldTag = character:FindFirstChild("SF_ESP_Tag")
		if oldTag then oldTag:Destroy() end
		local oldHl = character:FindFirstChild("SF_ESP_Hl")
		if oldHl then oldHl:Destroy() end
	end

	local function updateESP()
		for _, p in pairs(Players:GetPlayers()) do cleanESP(p.Character) end
		if not espEnabled and not staffEspEnabled then return end

		for _, targetPlayer in pairs(Players:GetPlayers()) do
			if targetPlayer == Player then continue end

			local function setupCharacterESP(character)
				task.wait(0.3)
				cleanESP(character)
				
				local isStaff, staffRole = checkIsStaff(targetPlayer)
				if staffEspEnabled and not espEnabled and not isStaff then return end
				if not espEnabled and not staffEspEnabled then return end

				local head = character:WaitForChild("Head", 5)
				local root = character:WaitForChild("HumanoidRootPart", 5)
				if not head or not root then return end

				local displayName = targetPlayer.Name
				local displayRole = "Joueur"
				local boxColor = Color3.fromRGB(0, 180, 255)

				if isStaff then
					displayRole = " STAFF [" .. (staffRole or "Admin") .. "]"
					boxColor = Color3.fromRGB(128, 128, 128)
				else
					local role, rColor = detectRole(targetPlayer)
					displayRole = role
					boxColor = rColor
				end

				local hl = Instance.new("Highlight")
				hl.Name = "SF_ESP_Hl"
				hl.FillColor = boxColor
				hl.OutlineColor = boxColor
				hl.FillTransparency = 0.6
				hl.OutlineTransparency = 0.1
				hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				hl.Parent = character

				local bgui = Instance.new("BillboardGui")
				bgui.Name = "SF_ESP_Tag"
				bgui.Size = UDim2.new(0, 200, 0, 60)
				bgui.AlwaysOnTop = true
				bgui.ExtentsOffset = Vector3.new(0, 3, 0)
				bgui.Parent = character

				local label = Instance.new("TextLabel")
				label.Size = UDim2.new(1, 0, 1, 0)
				label.BackgroundTransparency = 1
				label.Font = Enum.Font.GothamBold
				label.TextSize = 13
				label.TextColor3 = boxColor
				label.TextStrokeTransparency = 0.2
				label.TextStrokeColor3 = Color3.new(0,0,0)
				label.Parent = bgui

				local connection
				connection = RunService.RenderStepped:Connect(function()
					if not character.Parent or not Player.Character then
						connection:Disconnect()
						return
					end
					local myRoot = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
					local targetRoot = character and character:FindFirstChild("HumanoidRootPart")
					
					if myRoot and targetRoot then
						local distance = math.floor((myRoot.Position - targetRoot.Position).Magnitude)
						label.Text = string.format(" %s\n %s\n [%d m]", displayName, displayRole, distance)
					end
				end)
			end

			if targetPlayer.Character then task.spawn(setupCharacterESP, targetPlayer.Character) end
		end
	end

